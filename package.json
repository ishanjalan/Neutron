{
	"name": "neutron",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check": "turbo check",
		"dev:squish": "turbo dev --filter=squish",
		"dev:smash": "turbo dev --filter=smash",
		"dev:squash": "turbo dev --filter=squash",
		"dev:swirl": "turbo dev --filter=swirl",
		"test": "turbo test",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test:smoke": "playwright test -c playwright.smoke.config.ts",
		"test:e2e:ui": "playwright test --ui",
		"knip": "knip --include files,dependencies,unlisted",
		"lint": "turbo lint",
		"lint:fix": "turbo lint:fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"happy-dom": "^20.14.6",
		"knip": "^6.45.0",
		"lefthook": "^2.2.2",
		"playwright": "^1.65.0",
		"prettier": "3.10.0",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte-eslint-parser": "^1.10.1",
		"turbo": "^2.11.11",
		"typescript-eslint": "^8.72.2",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@12.19.0"
}
