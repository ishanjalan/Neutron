{
	"name": "neutron",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check": "turbo check",
		"dev:squish": "turbo dev --filter=squish",
		"dev:smash": "turbo dev --filter=smash",
		"dev:squash": "turbo dev --filter=squash",
		"dev:swirl": "turbo dev --filter=swirl",
		"test": "turbo test",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test:smoke": "playwright test -c playwright.smoke.config.ts",
		"test:e2e:ui": "playwright test --ui",
		"lint": "turbo lint",
		"lint:fix": "turbo lint:fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@testing-library/svelte": "^5.4.2",
		"@typescript-eslint/eslint-plugin": "^8.72.2",
		"@typescript-eslint/parser": "^8.72.2",
		"@vitest/browser": "^4.1.11",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^29.1.1",
		"lefthook": "^2.2.2",
		"playwright": "^1.65.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte-eslint-parser": "^1.10.1",
		"turbo": "^2.11.11",
		"typescript-eslint": "^8.72.2",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@9.15.0",
	"pnpm": {
		"overrides": {
			"brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
			"source-map-js@<1.2.2": "^1.2.2",
			"yaml@>=2.0.0 <2.8.3": "^2.8.3",
			"esbuild@>=0.27.3 <0.28.1": "^0.28.1"
		}
	}
}
