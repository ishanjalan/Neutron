{
	"name": "swirl",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run",
		"test:coverage": "vitest --coverage"
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@vitest/coverage-v8": "^4.1.11",
		"happy-dom": "^20.12.0",
		"lucide-svelte": "^0.577.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.0",
		"vite": "^8.3.8",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@neutron/config": "workspace:*",
		"@neutron/ui": "workspace:*",
		"@neutron/utils": "workspace:*",
		"gifsicle-wasm-browser": "^1.5.19",
		"gifski-wasm": "^2.2.0",
		"mediabunny": "^1.65.2"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
