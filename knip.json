{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": ["tests/**/*.ts"],
			"project": ["tests/**/*.ts"]
		},
		"apps/*": {
			"entry": [
				"src/routes/**/+*.{ts,svelte}",
				"src/params.ts",
				"src/service-worker/index.ts",
				"src/**/*.test.ts"
			],
			"project": ["src/**/*.{ts,svelte}"],
			"ignoreDependencies": ["tailwindcss"]
		},
		"packages/*": {
			"entry": ["src/index.ts", "src/*.ts"],
			"project": ["src/**/*.{ts,svelte}"]
		}
	},
	"ignoreIssues": {
		"apps/*/tsconfig.json": ["unlisted"]
	}
}
